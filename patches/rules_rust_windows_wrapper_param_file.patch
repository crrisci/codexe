+// This response file contains wrapper flags, not compiler flags. Expand only
+// before the separator: rustc response files keep their existing handling.
+fn expand_wrapper_args(
+    argv: Vec<String>,
+    mut read: impl FnMut(&str) -> io::Result<String>,
+) -> Result<Vec<String>, OptionError> {
+    let mut expanded = Vec::new();
+    let mut child = false;
+    for arg in argv {
+        if !child {
+            if arg == "--" {
+                child = true;
+            } else if let Some(path) = arg.strip_prefix("--wrapper-arg-file=") {
+                let text = read(path).map_err(|error| {
+                    OptionError::Generic(format!("cannot read wrapper argument file {path:?}: {error}"))
+                })?;
+                // Bazel's multiline format writes each argument verbatim.
+                // Do not shell-split spaces, unescape backslashes or recurse.
+                expanded.extend(text.lines().map(str::to_owned));
+                continue;
+            }
+        }
+        expanded.push(arg);
+    }
+    Ok(expanded)
+}
